SELECT
    c.customer_id,
    c.customer_name,
    SUM(oi.quantity * oi.price_per_unit) AS total_spent
FROM
    Customers c
JOIN
    Orders o ON c.customer_id = o.customer_id
JOIN
    Order_Items oi ON o.order_id = oi.order_id
GROUP BY
    c.customer_id, c.customer_name
ORDER BY
    total_spent DESC;
